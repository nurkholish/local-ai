APP_NAME=local-ai
ENV=local
LOG_LEVEL=INFO
LOG_JSON=true
PORT=8080

KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
KONG_RATE_LIMIT_PER_MIN=60
KONG_API_KEY_VALUE=dev-key

LLM_ROUTE_MODE=hybrid
LLM_MAX_RETRIES=2
LLM_TIMEOUT_S=30
LLM_ROUTE_CLASSIFIER_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LLM_ROUTE_LOCAL_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
LLM_ROUTE_FRONTIER_MODEL=gpt-4o-mini

LLM_MAX_OUTPUT_TOKENS=512
LLM_CACHE_PROMPT=true
LLM_EARLY_RETURN_CALCULATOR=true
LLM_STREAMING_ENABLED=true
LLM_FALLBACK_ENABLED=true

CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT_S=30

RETRY_BUDGET_S=120
RETRY_MAX_ATTEMPTS=3

PII_REDACTION_ENABLED=true
PII_REDACTION_ON_OUTPUT=true
DEDUP_ENABLED=true

OPENAI_API_KEY=

VLLM_ENABLED=false
VLLM_ROUTER_URL=http://vllm-router:8001/v1
VLLM_MAIN_URL=http://vllm-main:8002/v1
EMBEDDING_URL=http://embedding:8003

REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+asyncpg://agent:agent@postgres:5432/agent

MAX_AGENT_STEPS=8
MAX_TOOL_OUTPUT_CHARS=4000
TOOL_TIMEOUT_S=15
RATE_LIMIT_PER_MIN=60
MAX_HISTORY_TURNS=10
MAX_RAG_CHUNKS=5

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=local-ai-api
PROMETHEUS_ENABLED=true